// Simple solar-system n-body benchmark (Sun + 8 planets)
// Units: AU, days, solar masses.  G is absorbed into SOLAR_MASS.

SOLAR_MASS = 4 * PI * PI
DAYS_PER_YEAR = 365.24

// Body count
N = 9

// Parallel arrays (much faster than array-of-maps)
x  = []
y  = []
z  = []
vx = []
vy = []
vz = []
m  = []

// ---------------------------------------------------------------
// Initial conditions (approximate J2000-ish, heliocentric)
// ---------------------------------------------------------------

// 0 Sun
x[0] = 0
y[0] = 0
z[0] = 0
vx[0] = 0
vy[0] = 0
vz[0] = 0
m[0]  = SOLAR_MASS

// 1 Mercury
x[1]  =  0.387098
y[1]  =  0
z[1]  =  0
vx[1] =  0
vy[1] =  0.024600 * DAYS_PER_YEAR
vz[1] =  0
m[1]  = 1.6601e-7 * SOLAR_MASS

// 2 Venus
x[2]  =  0.723332
y[2]  =  0
z[2]  =  0
vx[2] =  0
vy[2] =  0.0179 * DAYS_PER_YEAR
vz[2] =  0
m[2]  = 2.4478e-6 * SOLAR_MASS

// 3 Earth
x[3]  =  1.000000
y[3]  =  0
z[3]  =  0
vx[3] =  0
vy[3] =  0.017202 * DAYS_PER_YEAR
vz[3] =  0
m[3]  = 3.003e-6 * SOLAR_MASS

// 4 Mars
x[4]  =  1.523679
y[4]  =  0
z[4]  =  0
vx[4] =  0
vy[4] =  0.01396 * DAYS_PER_YEAR
vz[4] =  0
m[4]  = 3.227e-7 * SOLAR_MASS

// 5 Jupiter
x[5]  =  5.204267
y[5]  =  0
z[5]  =  0
vx[5] =  0
vy[5] =  0.00756 * DAYS_PER_YEAR
vz[5] =  0
m[5]  = 9.5479e-4 * SOLAR_MASS

// 6 Saturn
x[6]  =  9.582017
y[6]  =  0
z[6]  =  0
vx[6] =  0
vy[6] =  0.00558 * DAYS_PER_YEAR
vz[6] =  0
m[6]  = 2.8588e-4 * SOLAR_MASS

// 7 Uranus
x[7]  = 19.229411
y[7]  =  0
z[7]  =  0
vx[7] =  0
vy[7] =  0.00393 * DAYS_PER_YEAR
vz[7] =  0
m[7]  = 4.3662e-5 * SOLAR_MASS

// 8 Neptune
x[8]  = 30.103661
y[8]  =  0
z[8]  =  0
vx[8] =  0
vy[8] =  0.00312 * DAYS_PER_YEAR
vz[8] =  0
m[8]  = 5.1514e-5 * SOLAR_MASS

// ---------------------------------------------------------------
// Offset momentum so the system barycentre stays at origin
// ---------------------------------------------------------------
fn offset_momentum() {
  px = 0
  py = 0
  pz = 0
  for i = 0 to N-1 {
    px += vx[i] * m[i]
    py += vy[i] * m[i]
    pz += vz[i] * m[i]
  }
  vx[0] = -px / m[0]
  vy[0] = -py / m[0]
  vz[0] = -pz / m[0]
}

// ---------------------------------------------------------------
// Total energy (kinetic + potential)
// ---------------------------------------------------------------
fn energy() {
  e = 0
  for i = 0 to N-1 {
    // kinetic
    e += 0.5 * m[i] * (vx[i]*vx[i] + vy[i]*vy[i] + vz[i]*vz[i])

    // potential
    for j = i+1 to N-1 {
      dx = x[i] - x[j]
      dy = y[i] - y[j]
      dz = z[i] - z[j]
      distance = sqrt(dx*dx + dy*dy + dz*dz)
      e -= (m[i] * m[j]) / distance
    }
  }
  result = e
}

// ---------------------------------------------------------------
// Advance the system by dt (symplectic Euler)
// ---------------------------------------------------------------
fn advance(dt) {
  // update velocities
  for i = 0 to N-1 {
    for j = i+1 to N-1 {
      dx: number = x[i] - x[j]
      dy: number = y[i] - y[j]
      dz: number = z[i] - z[j]
      dist2: number = dx*dx + dy*dy + dz*dz
      dist: number = sqrt(dist2)
      mag: number = dt / (dist2 * dist)

      // mutual force
      fx: number = dx * mag
      fy: number = dy * mag
      fz: number = dz * mag

      vx[i] -= fx * m[j]
      vy[i] -= fy * m[j]
      vz[i] -= fz * m[j]

      vx[j] += fx * m[i]
      vy[j] += fy * m[i]
      vz[j] += fz * m[i]
    }
  }

  // update positions
  for i = 0 to N-1 {
    x[i] += dt * vx[i]
    y[i] += dt * vy[i]
    z[i] += dt * vz[i]
  }
}

// ---------------------------------------------------------------
// Benchmark
// ---------------------------------------------------------------
offset_momentum()

writeln('Initial energy: ', energy())

t0 = ticks()

steps = 100000         // increase for a heavier benchmark
dt    = 0.01           // days

for s = 1 to steps {
  advance(dt)
}

t1 = ticks()

writeln('Final energy:   ', energy())
writeln('Steps:          ', steps)
writeln('Time:           ', t1 - t0, ' ms')