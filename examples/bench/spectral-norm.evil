// Algorithm from the Computer Language Benchmarks Game

N = 1000

fn A(i, j) {
  result = 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1)
}

fn MultiplyAv(n, v, Av) {
  for i = 0 to n-1 {
    s = 0.0
    for j = 0 to n-1 {
      s += A(i, j) * v[j]
    }
    Av[i] = s
  }
}

fn MultiplyAtv(n, v, Atv) {
  for i = 0 to n-1 {
    s = 0.0
    for j = 0 to n-1 {
      s += A(j, i) * v[j]
    }
    Atv[i] = s
  }
}

fn MultiplyAtAv(n, v, AtAv) {
  u = []
  u[n-1] = 0          // pre-size the temporary array
  MultiplyAv(n, v, u)
  MultiplyAtv(n, u, AtAv)
}

// ---------- main ----------
u = []
v = []
u[N-1] = 0            // pre-size arrays (makes them proper arrays)
v[N-1] = 0

for i = 0 to N-1 {
  u[i] = 1.0
}

t0 = ticks()

for i = 0 to 9 {      // 10 iterations of the power method
  MultiplyAtAv(N, u, v)
  MultiplyAtAv(N, v, u)
}

vBv = 0.0
vv  = 0.0
for i = 0 to N-1 {
  vBv += u[i] * v[i]
  vv  += v[i] * v[i]
}

res = sqrt(vBv / vv)

t1 = ticks()

writeln(res)
writeln('Time: ', t1 - t0, ' ms')