const N = 4999999  

fn irange(minv, maxv) {
  result = coroutine_create(fn(minv, maxv) {
    for i = minv to maxv
      yield(i)
  }, minv, maxv)
}

writeln('Numeric for loop')
t = ticks()

a = 0
for i = 0 to N
  a = a + i

writeln('\nTime: ', ticks() - t, 'ms')
writeln('Total: ', a)

writeln()
writeln('For loop using generator function')
t = ticks()

a = 0
for i of irange(0, N)
  a = a + i

writeln('\nTime: ', ticks() - t, 'ms')
writeln('Total: ', a)
