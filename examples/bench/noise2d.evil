// Based on https://gist.github.com/nowl/828013

var noise2d_hash = [
  208,34,231,213,32,248,233,56,161,78,24,140,71,48,140,254,245,255,247,247,40,
  185,248,251,245,28,124,204,204,76,36,1,107,28,234,163,202,224,245,128,167,204,
  9,92,217,54,239,174,173,102,193,189,190,121,100,108,167,44,43,77,180,204,8,81,
  70,223,11,38,24,254,210,210,177,32,81,195,243,125,8,169,112,32,97,53,195,13,
  203,9,47,104,125,117,114,124,165,203,181,235,193,206,70,180,174,0,167,181,41,
  164,30,116,127,198,245,146,87,224,149,206,57,4,192,210,65,210,129,240,178,105,
  228,108,245,148,140,40,35,195,38,58,65,207,215,253,65,85,208,76,62,3,237,55,89,
  232,50,217,64,244,157,199,121,252,90,17,212,203,149,152,140,187,234,177,73,174,
  193,100,192,143,97,53,145,135,19,103,13,90,135,151,199,91,239,247,33,39,145,
  101,120,99,3,186,86,99,41,237,203,111,79,220,135,158,42,30,154,120,67,87,167,
  135,176,183,191,253,115,184,21,233,58,129,233,142,39,128,211,118,137,139,255,
  114,20,218,113,154,27,127,246,250,1,8,198,250,209,92,222,173,21,88,102,219
]

var noise2d_seed = 0

fn noise2_single(x, y) {
  local tmp = noise2d_hash[(y + noise2d_seed) % 256]
  result = noise2d_hash[(tmp + x) % 256]
}

fn lin_inter(x, y, s) {
  result = x + s * (y-x)
}

fn smooth_inter(x, y, s) {
  result = lin_inter(x, y, s * s * (3-2*s))
}

fn noise2smooth(x, y) {
  local x_int = trunc(x)
  local y_int = trunc(y)
  local x_frac = frac(x)
  local y_frac = frac(y)
  local s = noise2_single(x_int, y_int)
  local t = noise2_single(x_int+1, y_int)
  local u = noise2_single(x_int, y_int+1)
  local v = noise2_single(x_int+1, y_int+1)
  local low = smooth_inter(s, t, x_frac)
  local high = smooth_inter(u, v, x_frac)
  result = smooth_inter(low, high, y_frac)
}

fn noise2d(x, y, freq, depth) {
  local xa = x*freq
  local ya = y*freq
  local amp = 1.0
  local fin = 0
  local div = 0.0

  for i = 0 to depth - 1 {
    div += 256 * amp
    fin += noise2smooth(xa, ya) * amp
    amp /= 2
    xa *= 2
    ya *= 2
  }
  result = fin / div
}

const SIZE = 256
var a = []
array_resize(a, SIZE * SIZE)

var t = ticks()

for x = 0 to SIZE - 1
  for y = 0 to SIZE - 1
    a[x + y * SIZE] = noise2d(x, y, 0.1, 8)

writeln('Finished in ', ticks() - t, 'ms')