// Implement OOP using "self" mechanism, with inheritance and method override
// Note: Needs to access properties via "props"

// Base class
Object = []
Object.class = Object
// Helper method to check if "self" inherited from class "cls"
Object.inherited_from = fn(cls) {
  local this = self
  while this != null {
    if this.class == cls {
      return (true)
    }
    this = this.super
  }
  return (false)
}

// Helper function to extend a class
fn class_extends(parent, data) {
  result = map_clone(parent)
  result.super = map_clone(parent)
  result += data
  result.class = result
} 

// Helper function to create an instance of a class
fn object_new(class) {
  result = map_clone(class)
  result.props = []
  local co = result
  while co.super != null {
    co.super = map_clone(co.super)
    co.super.props = result.props
    co = co.super
  }
}

Animal = class_extends(Object, [
  props: [
    name: null,
  ],
  create: fn(name) {
    result = self
    result.props.name = name
  },
  make_sound: fn() {
    writeln('${self.props.name} start making sound')
  }
])

Dog = class_extends(Animal, [
  props: [
    age: null,
  ],
  create: fn(name, age) {
    result = self
    result.super.create(name)
    result.props.age = age
  },
  make_sound: fn() {
    self.super.make_sound()
    writeln('${self.props.name} barks: Woof Woof!')
  },
  show_age: fn() {
    writeln('${self.props.name} is ${self.props.age} year-old')
  }
])

Cat = class_extends(Animal, [
  make_sound: fn() {
    self.super.make_sound()
    writeln('${self.props.name} meows: meow meow!')
  }
])

CatPurr = class_extends(Cat, [
  make_sound: fn() {
    self.super.make_sound()
    writeln('${self.props.name} purrs!')
  }
])

dog = object_new(Dog).create('My dog', 4)
dog2 = object_new(Dog).create("My brother's dog", 6)
cat = object_new(Cat).create('My cat')
cat2 = object_new(CatPurr).create("My sister's cat")

dog.show_age()
dog.make_sound()
writeln()

dog2.show_age()
dog2.make_sound()
writeln()

cat.make_sound()
writeln()

cat2.make_sound()
writeln()

writeln('Is "dog" inherited from class Object? ', dog.inherited_from(Object))
writeln('Is "dog" inherited from class Animal? ', dog.inherited_from(Animal))
writeln('Is "dog" inherited from class Dog? ', dog.inherited_from(Dog))
writeln('Is "dog" inherited from class Cat? ', dog.inherited_from(Cat))

