// Implement OOP using "self" mechanism, with inheritance and method override
// Note: Needs to access properties via "props"

// Base class
Object = []
Object.class = Object
// Helper method to check if "self" inherited from class "class"
Object.inheritedFrom = fn(class) {
  local this = self
  while this != null {
    if this.class == class {
      return (true)
    }
    this = this.super
  }
  return (false)
}

// Helper function to extend a class
fn class(parent, data) {
  result = parent + data
  result.super = map_clone(parent)
  result.class = result
} 

// Helper function to create an instance of a class
fn new(class) {
  result = map_clone(class)
  result.props = []
  local co = result
  while co.super != null {
    co.super = map_clone(co.super)
    co.super.props = result.props
    co = co.super
  }
}

Animal = class(Object, [
  props: [
    name: null,
  ],
  init: fn(name) {
    self.props.name = name
    return (self)
  },
  makeSound: fn() {
    writeln('${self.props.name} start making sound')
  }
])

Dog = class(Animal, [
  props: [
    age: null,
  ],
  init: fn(name, age) {
    self.super.init(name)
    self.props.age = age
    return (self)
  },
  makeSound: fn() {
    self.super.makeSound()
    writeln('${self.props.name} barks: Woof Woof!')
  },
  showAge: fn() {
    writeln('${self.props.name} is ${self.props.age} year-old')
  }
])

Cat = class(Animal, [
  makeSound: fn() {
    self.super.makeSound()
    writeln('${self.props.name} meows: meow meow!')
  }
])

CatPurr = class(Cat, [
  makeSound: fn() {
    self.super.makeSound()
    writeln('${self.props.name} purrs!')
  }
])

dog = new(Dog).init('My dog', 4)
dog2 = new(Dog).init("My brother's dog", 6)
cat = new(Cat).init('My cat')
cat2 = new(CatPurr).init("My sister's cat")

dog.showAge()
dog.makeSound()
writeln()

dog2.showAge()
dog2.makeSound()
writeln()

cat.makeSound()
writeln()

cat2.makeSound()
writeln()

writeln('Is "dog" inherited from class Object? ', dog.inheritedFrom(Object))
writeln('Is "dog" inherited from class Animal? ', dog.inheritedFrom(Animal))
writeln('Is "dog" inherited from class Dog? ', dog.inheritedFrom(Dog))
writeln('Is "dog" inherited from class Cat? ', dog.inheritedFrom(Cat))
writeln('Is "dog.class" equal to class Dog? ', dog.class == Dog)
writeln('Is "dog.class" equal to class Animal? ', dog.class == Animal)

